{
    //Autocompletado dentro de templates
    "emmet.includeLanguages": {
        "django-html": "html",
        "jinja-html": "html"
    },
    "[django-html]": {
        "editor.defaultFormatter": "monosans.djlint",
        "editor.quickSuggestions": {
            "comments": true,
            "other": true,
            "strings": true
        },
        "editor.detectIndentation": false,
        "editor.tabSize": 2,
        "editor.wordWrap": "on",
    },
    "files.associations": {
        "*.css": "tailwindcss"
    },
    "editor.quickSuggestions": {
        "strings": "on"
    },
    "editor.wordWrap": "on",
    "files.exclude": {
        ".venv/": true,
        "**/__pycache__/": true,
        "Backups/": true,
        "Documentos/": true,
        "tailwind.config.js": true,
        ".ruff_cache/": true,
        ".vscode/": true,
        "package-lock.json": true,
        "package.json": true,
        "node_modules/": true
    }
}